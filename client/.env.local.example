# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real secrets.
#
# The Next.js app serves BOTH the website and the API (src/app/api), so this
# is now the only env file you need. There is no separate server to configure.

# --- PostgreSQL ---
# Local example (after `createdb portfolio`):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# --- Admin Panel Login ---
# The credentials for /admin. Change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Any long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Image uploads (Vercel Blob) ---
# From the Vercel project's Storage tab. Without it, /api/upload returns a
# clear 500 and image upload in the admin panel is disabled.
BLOB_READ_WRITE_TOKEN=

# --- Contact form email (optional) ---
# The form currently builds a mailto: link, so these are only needed if you
# wire up the POST /api/contact endpoint.
# Gmail needs an "app password", not your real account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
CONTACT_RECEIVER=you@gmail.com

# --- Optional ---
# Defaults to 1. Raise only if your database host has a generous connection
# limit; each warm serverless instance is its own process.
DATABASE_POOL_MAX=1
